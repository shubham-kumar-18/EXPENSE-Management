# Copy this file to .env for local development. Never commit real values.
MONGO_URI=
JWT_SECRET=
PORT=5002
AI_API_KEY=
# Optional: Google AI Studio Gemini model. Defaults to gemini-2.5-flash-lite.
AI_MODEL=gemini-2.5-flash-lite

# SMTP credentials must also be added to the deployed backend's environment settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
